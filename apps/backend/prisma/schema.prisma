  note            String?

  legacyAdmissionId String? @map("legacy_admission_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@index([deletedAt])
  @@map("inventory_ipd_admissions")
}

