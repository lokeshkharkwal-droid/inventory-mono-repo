// ── Returns, deliveries, financials, gift cards (deferred extensions) ─────────────

/// A purchase return (goods sent back to the supplier). Reverses inbound stock.
model InventoryPurchaseReturn {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  branchId   String   @map("branch_id")
  purchaseId String   @map("purchase_id")
  reference  String
  date       DateTime
  total      Decimal  @default(0) @db.Decimal(18, 4)
  note       String?
  createdBy  String?  @map("created_by")

  // ── EZHT return-purchase parity ──
  supplierId        String?  @map("supplier_id")
  surcharge         Decimal  @default(0) @db.Decimal(18, 4)
  productTax        Decimal  @default(0) @map("product_tax") @db.Decimal(18, 4)
  orderDiscount     Decimal  @default(0) @map("order_discount") @db.Decimal(18, 4)
  orderDiscountSpec String?  @map("order_discount_spec")
  orderTax          Decimal  @default(0) @map("order_tax") @db.Decimal(18, 4)
  orderTaxId        String?  @map("order_tax_id")
  totalTax          Decimal  @default(0) @map("total_tax") @db.Decimal(18, 4)
  roundoff          Decimal  @default(0) @db.Decimal(18, 4)
  grandTotal        Decimal  @default(0) @map("grand_total") @db.Decimal(18, 4)
  igst              Decimal  @default(0) @db.Decimal(18, 4)
  cgst              Decimal  @default(0) @db.Decimal(18, 4)
  sgst              Decimal  @default(0) @db.Decimal(18, 4)
  taxMethod         String?  @map("tax_method")
  gstNumber         String?  @map("gst_number")
  gstState          String?  @map("gst_state")
  attachmentUrl     String?  @map("attachment_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items InventoryPurchaseReturnItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([purchaseId])
  @@index([deletedAt])
  @@map("inventory_purchase_returns")
}

/// A purchase-return line.
model InventoryPurchaseReturnItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  returnId    String  @map("return_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  quantity    Decimal @db.Decimal(18, 4)
  cost        Decimal @db.Decimal(18, 4)
  subtotal    Decimal @db.Decimal(18, 4)

  // ── EZHT return-item parity ──
  purchaseItemId String?   @map("purchase_item_id")
  netUnitCost    Decimal   @default(0) @map("net_unit_cost") @db.Decimal(18, 4)
  taxRate        Decimal   @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  discount       Decimal   @default(0) @db.Decimal(18, 4)
  discountSpec   String?   @map("discount_spec")
  mrp            Decimal?  @db.Decimal(18, 4)
  batchNo        String?   @map("batch_no")
  expiryDate     DateTime? @map("expiry_date")
  packSize       Decimal?  @map("pack_size") @db.Decimal(18, 4)
  hsnCode        String?   @map("hsn_code")
  igst           Decimal   @default(0) @db.Decimal(18, 4)
  cgst           Decimal   @default(0) @db.Decimal(18, 4)
  sgst           Decimal   @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  return InventoryPurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@index([productId])
  @@map("inventory_purchase_return_items")
}

/// A sale return (goods returned by the customer). Restocks + optional refund.
model InventorySaleReturn {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  branchId     String   @map("branch_id")
  saleId       String   @map("sale_id")
  reference    String
  date         DateTime
  total        Decimal  @default(0) @db.Decimal(18, 4)
  refundAmount Decimal  @default(0) @map("refund_amount") @db.Decimal(18, 4)
  note         String?
  createdBy    String?  @map("created_by")

  // ── EZHT return-sale parity (list columns + detail modal + payments) ──
  /// Originating sale reference snapshot (EZHT list "Sale Reference").
  saleReference String?  @map("sale_reference")
  /// Customer name snapshot (EZHT list "Customer").
  customer      String?
  /// Return surcharge (EZHT `surcharge`) — SUBTRACTED from the grand total.
  surcharge     Decimal  @default(0) @db.Decimal(18, 4)
  productTax    Decimal  @default(0) @map("product_tax") @db.Decimal(18, 4)
  orderDiscount Decimal  @default(0) @map("order_discount") @db.Decimal(18, 4)
  orderTax      Decimal  @default(0) @map("order_tax") @db.Decimal(18, 4)
  totalTax      Decimal  @default(0) @map("total_tax") @db.Decimal(18, 4)
  /// EZHT: grand_total = total + total_tax − surcharge − order_discount.
  grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(18, 4)
  paid          Decimal  @default(0) @db.Decimal(18, 4)
  paymentStatus String   @default("PENDING") @map("payment_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items    InventorySaleReturnItem[]
  payments InventorySaleReturnPayment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("inventory_sale_returns")
}

/// A payment recorded against a sale return (legacy: return payments live on the
/// same `sale_payments` table, keyed by the returned sale). Mirrors
/// {@link InventorySalePayment}. EZHT blocks adding a payment once a fully-paid
/// return has `paid == grand_total`.
model InventorySaleReturnPayment {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  returnId  String  @map("return_id")
  amount    Decimal @db.Decimal(18, 4)
  method    String  @default("CASH")
  reference String?
  date      DateTime
  note      String?
  createdBy String? @map("created_by")

  chequeNo   String? @map("cheque_no")
  ccNo       String? @map("cc_no")
  ccHolder   String? @map("cc_holder")
  ccType     String? @map("cc_type")
  ccMonth    String? @map("cc_month")
  ccYear     String? @map("cc_year")
  giftCardNo String? @map("gift_card_no")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  return InventorySaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@map("inventory_sale_return_payments")
}

/// A sale-return line.
model InventorySaleReturnItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  returnId    String  @map("return_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  quantity    Decimal @db.Decimal(18, 4)
  price       Decimal @db.Decimal(18, 4)
  subtotal    Decimal @db.Decimal(18, 4)
  /// Batch/serial snapshot of the returned line (EZHT view_return "Serial No").
  serialNo    String? @map("serial_no")

  createdAt DateTime @default(now()) @map("created_at")

  return InventorySaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@index([productId])
  @@map("inventory_sale_return_items")
}

/// A delivery record for a sale (legacy deliveries).
model InventorySaleDelivery {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  saleId     String   @map("sale_id")
  /// Delivery-order reference (EZHT `do_reference_no`).
  reference  String
  /// PENDING | DISPATCHED | DELIVERED. Retained for back-compat; EZHT has no
  /// delivery status workflow, so the UI no longer surfaces it.
  status     String   @default("PENDING")
  trackingNo String?  @map("tracking_no")
  /// EZHT `sale_reference_no` — the originating sale's reference (snapshot).
  saleReferenceNo String? @map("sale_reference_no")
  /// EZHT `customer` — customer name snapshot shown on the list/document.
  customer   String?
  deliveredTo String? @map("delivered_to")
  address    String?
  date       DateTime
  note       String?
  createdBy  String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("inventory_sale_deliveries")
}

/// A standalone operating expense (tied to an expense category).
model InventoryExpense {
