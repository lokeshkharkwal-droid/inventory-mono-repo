  ccType     String? @map("cc_type")
  ccMonth    String? @map("cc_month")
  ccYear     String? @map("cc_year")
  giftCardNo String? @map("gift_card_no")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  sale InventorySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@map("inventory_sale_payments")
}

// ── Transfers ─────────────────────────────────────────────────────────────────

/// Inter-branch (warehouse) stock transfer, two-stage (legacy `ez_transfers`).
model InventoryTransfer {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  fromBranchId String   @map("from_branch_id")
  toBranchId   String   @map("to_branch_id")
  reference    String
  date         DateTime
  /// PENDING | IN_TRANSIT (sent, stock left source) | COMPLETED (received).
  status       String   @default("PENDING")
  note         String?
  createdBy    String?  @map("created_by")

  // EZ Health Track "Add Transfer" parity (header totals + departments + document).
  fromDepartment String?  @map("from_department")
  toDepartment   String?  @map("to_department")
  shipping       Decimal? @db.Decimal(18, 4)
  total          Decimal? @db.Decimal(18, 4)
  totalTax       Decimal? @map("total_tax") @db.Decimal(18, 4)
  grandTotal     Decimal? @map("grand_total") @db.Decimal(18, 4)
  attachmentUrl  String?  @map("attachment_url")

  legacyTransferId String? @map("legacy_transfer_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items InventoryTransferItem[]

  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([deletedAt])
  @@index([legacyTransferId])
  @@map("inventory_transfers")
}

/// A transfer line.
model InventoryTransferItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  transferId  String  @map("transfer_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  quantity    Decimal @db.Decimal(18, 4)
  /// EZHT `quantity_balance`: set = quantity at creation (partial-receive field).
  quantityBalance Decimal? @map("quantity_balance") @db.Decimal(18, 4)
  cost        Decimal @default(0) @db.Decimal(18, 4)

  // EZ Health Track transfer item columns.
  expiryDate    DateTime? @map("expiry_date")
  productSerial String?   @map("product_serial")
  /// The specific source-branch batch this line draws stock from (EZHT `option_id`
  /// + `serial_no`). Null = legacy/product-level line (falls back to product stock).
  batchId       String?   @map("batch_id")
  batchNo       String?   @map("batch_no")
  packSize      String?   @map("pack_size")
  packQuantity  Decimal?  @map("pack_quantity") @db.Decimal(18, 4)
  rate          Decimal?  @db.Decimal(18, 4)
  mrp           Decimal?  @db.Decimal(18, 4)
  packMrp       Decimal?  @map("pack_mrp") @db.Decimal(18, 4)
  hsnCode       String?   @map("hsn_code")
  taxRate       Decimal?  @map("tax_rate") @db.Decimal(9, 4)
  taxAmount     Decimal?  @map("tax_amount") @db.Decimal(18, 4)
  subtotal      Decimal?  @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([transferId])
  @@index([productId])
  @@index([batchId])
  @@map("inventory_transfer_items")
}

// ── Requisitions ──────────────────────────────────────────────────────────────

/// Internal stock requisition from a requesting branch to a source branch
/// (legacy `ez_requisitions`).
model InventoryRequisition {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
