  branchId     String   @map("branch_id")
  /// Source branch asked to supply (legacy `source_branch_id`).
  fromBranchId String?  @map("from_branch_id")
  reference    String
  date         DateTime
  /// PENDING | APPROVED | REJECTED | RECEIVED | TRANSFERRED.
  status       String   @default("PENDING")
  note         String?
  createdBy    String?  @map("created_by")
  approvedBy   String?  @map("approved_by")

  // ── EZHT add-requisition parity ──
  /// Source/destination departments (names snapshotted from kalnostics).
  fromDepartmentId   String? @map("from_department_id")
  fromDepartmentName String? @map("from_department_name")
  toDepartmentId     String? @map("to_department_id")
  toDepartmentName   String? @map("to_department_name")
  /// Legacy "Local Purchase" Yes/No flag.
  localPurchase      Boolean @default(false) @map("local_purchase")
  /// EZHT identity fields (id + snapshotted name): Biller / Supplier / Customer.
  billerId     String? @map("biller_id")
  billerName   String? @map("biller_name")
  supplierId   String? @map("supplier_id")
  supplierName String? @map("supplier_name")
  customerId   String? @map("customer_id")
  customerName String? @map("customer_name")
  /// EZHT Referral block (legacy `ReferralForm[...]`).
  referralSourceType      String? @map("referral_source_type")
  referralContactFname    String? @map("referral_contact_fname")
  referralContactMname    String? @map("referral_contact_mname")
  referralContactLname    String? @map("referral_contact_lname")
  referralBusinessName    String? @map("referral_business_name")
  referralBusinessAddress String? @map("referral_business_address")
  referralDoctorName      String? @map("referral_doctor_name")
  referralSlnId           String? @map("referral_sln_id")
  /// Order-level money (mirrors sale/purchase headers).
  subtotal          Decimal @default(0) @db.Decimal(18, 4)
  productDiscount   Decimal @default(0) @map("product_discount") @db.Decimal(18, 4)
  /// Raw order-discount spec as entered (may hold "10%"); `orderDiscount` is resolved.
  orderDiscountSpec String? @map("order_discount_spec")
  orderDiscount     Decimal @default(0) @map("order_discount") @db.Decimal(18, 4)
  orderTaxId        String? @map("order_tax_id")
  orderTax          Decimal @default(0) @map("order_tax") @db.Decimal(18, 4)
  shipping          Decimal @default(0) @db.Decimal(18, 4)
  totalTax          Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  grandTotal        Decimal @default(0) @map("grand_total") @db.Decimal(18, 4)
  totalItems        Int     @default(0) @map("total_items")
  attachmentUrl     String? @map("attachment_url")
  /// Set once an approved requisition is converted into a stock transfer.
  convertedToTransferId String? @map("converted_to_transfer_id")
  updatedBy             String? @map("updated_by")

  legacyRequisitionId String? @map("legacy_requisition_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items         InventoryRequisitionItem[]
  statusHistory InventoryRequisitionStatusHistory[]

  @@index([tenantId])
  @@index([branchId])
  @@index([fromBranchId])
  @@index([deletedAt])
  @@index([legacyRequisitionId])
  @@map("inventory_requisitions")
}

/// A requisition line (snapshots product name/code + line money at request time).
model InventoryRequisitionItem {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  requisitionId String  @map("requisition_id")
  productId     String  @map("product_id")
