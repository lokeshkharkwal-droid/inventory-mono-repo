  orderDiscount Decimal  @default(0) @map("order_discount") @db.Decimal(18, 4)
  shipping      Decimal  @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(18, 4)
  paid          Decimal  @default(0) @db.Decimal(18, 4)
  /// PENDING | PARTIAL | PAID.
  paymentStatus String   @default("PENDING") @map("payment_status")
  note          String?
  createdBy     String?  @map("created_by")

  /// Blood-donation PO (legacy BD purchase): stock-in sourced from a donor.
  isBloodDonation Boolean @default(false) @map("is_blood_donation")
  donorName       String? @map("donor_name")

  // ── EZHT add-purchase parity ──
  orderDiscountSpec String?   @map("order_discount_spec")
  productDiscount   Decimal   @default(0) @map("product_discount") @db.Decimal(18, 4)
  orderTaxId        String?   @map("order_tax_id")
  orderTaxSpec      String?   @map("order_tax_spec")
  totalTax          Decimal   @default(0) @map("total_tax") @db.Decimal(18, 4)
  roundoff          Decimal   @default(0) @db.Decimal(18, 4)
  totalItems        Int       @default(0) @map("total_items")
  paymentTerm       Int?      @map("payment_term")
  dueDate           DateTime? @map("due_date")
  gstNumber         String?   @map("gst_number")
  gstState          String?   @map("gst_state")
  taxMethod         String?   @map("tax_method")
  igst              Decimal   @default(0) @db.Decimal(18, 4)
  cgst              Decimal   @default(0) @db.Decimal(18, 4)
  sgst              Decimal   @default(0) @db.Decimal(18, 4)
