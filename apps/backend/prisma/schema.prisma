// ── Sales ─────────────────────────────────────────────────────────────────────

/// Sales invoice to a customer (legacy `ez_sales`).
model InventorySale {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  branchId      String   @map("branch_id")
  customerId    String   @map("customer_id")
  billerName    String?  @map("biller_name")
  reference     String
  date          DateTime
  /// COMPLETED (stock out) | PENDING.
  status        String   @default("COMPLETED")
  subtotal      Decimal  @default(0) @db.Decimal(18, 4)
  orderTax      Decimal  @default(0) @map("order_tax") @db.Decimal(18, 4)
  orderDiscount Decimal  @default(0) @map("order_discount") @db.Decimal(18, 4)
  shipping      Decimal  @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(18, 4)
  paid          Decimal  @default(0) @db.Decimal(18, 4)
  paymentStatus String   @default("PENDING") @map("payment_status")
  note          String?
  staffNote     String?  @map("staff_note")
  createdBy     String?  @map("created_by")
  /// Set when this sale was rung up through a POS register session.
  posSessionId  String?  @map("pos_session_id")

  // ── EZHT add-sale parity ──
  billerId         String?   @map("biller_id")
  /// Raw order-discount spec as entered (may hold "10%"); `orderDiscount` is resolved.
  orderDiscountSpec String?  @map("order_discount_spec")
  productDiscount  Decimal   @default(0) @map("product_discount") @db.Decimal(18, 4)
  orderTaxId       String?   @map("order_tax_id")
  orderTaxSpec     String?   @map("order_tax_spec")
  totalTax         Decimal   @default(0) @map("total_tax") @db.Decimal(18, 4)
  roundoff         Decimal   @default(0) @db.Decimal(18, 4)
  totalItems       Int       @default(0) @map("total_items")
  paymentTerm      Int?      @map("payment_term")
  dueDate          DateTime? @map("due_date")
  /// India GST: igst OR cgst+sgst depending on `taxMethod` (inter/intra-state).
  gstNumber        String?   @map("gst_number")
  gstState         String?   @map("gst_state")
  taxMethod        String?   @map("tax_method")
  igst             Decimal   @default(0) @db.Decimal(18, 4)
  cgst             Decimal   @default(0) @db.Decimal(18, 4)
  sgst             Decimal   @default(0) @db.Decimal(18, 4)
  attachmentUrl    String?   @map("attachment_url")
  quoteId          String?   @map("quote_id")
  doctorName       String?   @map("doctor_name")
  /// Order Tags free-text (EZHT `order_tags`) surfaced under More Options.
  orderTags        String?   @map("order_tags")
  /// External-referral link (opaque kalnostics id) + name snapshot for the sale
  /// "Referral" field. The id is resolved by kalnostics; the name is stored so
  /// documents/lists don't need a round-trip.
  referralId       String?   @map("referral_id")
  referralName     String?   @map("referral_name")

  legacySaleId String? @map("legacy_sale_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  customer InventoryCustomer      @relation(fields: [customerId], references: [id])
  items    InventorySaleItem[]
  payments InventorySalePayment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([customerId])
  @@index([deletedAt])
  @@index([legacySaleId])
  @@index([posSessionId])
  @@map("inventory_sales")
}

/// A sale line (snapshots product name/code + unit cost at sale time).
model InventorySaleItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  saleId      String  @map("sale_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  quantity    Decimal @db.Decimal(18, 4)
  price       Decimal @db.Decimal(18, 4)
  cost        Decimal @default(0) @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  subtotal    Decimal @db.Decimal(18, 4)

  // ── EZHT sale-item parity ──
  optionId     String?   @map("option_id")
  netUnitPrice Decimal   @default(0) @map("net_unit_price") @db.Decimal(18, 4)
  realUnitPrice Decimal  @default(0) @map("real_unit_price") @db.Decimal(18, 4)
  packSize     Decimal?  @map("pack_size") @db.Decimal(18, 4)
  packQuantity Decimal?  @map("pack_quantity") @db.Decimal(18, 4)
  serialNo     String?   @map("serial_no")
  /// Imaging/radiology exposure count for this line (legacy inv_exposure) — Exposures report.
  invExposure  Int       @default(0) @map("inv_exposure")
  expiryDate   DateTime? @map("expiry_date")
  hsnCode      String?   @map("hsn_code")
  taxMethod    String?   @map("tax_method")
  discountSpec String?   @map("discount_spec")
  igst         Decimal   @default(0) @db.Decimal(18, 4)
  cgst         Decimal   @default(0) @db.Decimal(18, 4)
  sgst         Decimal   @default(0) @db.Decimal(18, 4)

  /// The batch this line drew its stock from (one line = one batch). Nullable for
  /// non-stock-tracked products and legacy rows created before batch-aware sales.
  batchId String? @map("batch_id")

  createdAt DateTime @default(now()) @map("created_at")

  sale  InventorySale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch InventoryProductBatch? @relation(fields: [batchId], references: [id])

  @@index([tenantId])
  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@map("inventory_sale_items")
}

/// A payment received against a sale (legacy `ez_sale_payments`).
model InventorySalePayment {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  saleId    String  @map("sale_id")
  amount    Decimal @db.Decimal(18, 4)
  /// Primary method keyword (CASH | CHEQUE | CARD | GIFT_CARD | DEPOSIT | PG | BANK_TRANSFER).
  method    String  @default("CASH")
  reference String?
  date      DateTime
  note      String?
  createdBy String? @map("created_by")

  // ── EZHT payment-method detail parity ──
