  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  material InventoryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([materialId])
  @@map("inventory_material_damages")
}

/// A recorded material repair.
model InventoryMaterialRepair {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  materialId String   @map("material_id")
  cost       Decimal  @default(0) @db.Decimal(18, 4)
  status     String   @default("PENDING")
  date       DateTime
  note       String?
  createdBy  String?  @map("created_by")

