  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("inventory_master_variants")
}

/// Platform-level canonical EXPENSE CATEGORY (SiteAdmin-managed).
model InventoryMasterExpenseCategory {
  id         String   @id @default(uuid())
  code       String?
  name       String
  taxRateId  String?  @map("tax_rate_id")
  /// INCLUSIVE | EXCLUSIVE.
  taxMethod  String?  @map("tax_method")
  isActive   Boolean  @default(true) @map("is_active")
  createdBy  String?  @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  taxRate InventoryMasterTaxRate? @relation("MasterExpenseCategoryTax", fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("inventory_master_expense_categories")
}

/// Platform-level canonical INCOME CATEGORY (SiteAdmin-managed).
model InventoryMasterIncomeCategory {
  id         String   @id @default(uuid())
  code       String?
  name       String
  taxRateId  String?  @map("tax_rate_id")
  taxMethod  String?  @map("tax_method")
  isActive   Boolean  @default(true) @map("is_active")
  createdBy  String?  @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  taxRate InventoryMasterTaxRate? @relation("MasterIncomeCategoryTax", fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("inventory_master_income_categories")
}

/// Platform-level master product catalogue (legacy `tenant_id=0` master_products),
/// maintained centrally by a SiteAdmin. Has NO tenant_id — it sits above tenants
/// and carries no RLS policy. Tenants browse importable masters and import copies
/// into their own `inventory_products` (linked back via `sourceMasterProductId`).
model InventoryMasterProduct {
  id          String  @id @default(uuid())
  code        String?
  name        String
  category    String?
  /// Sub-classification name (find-or-created under `category` on import).
  subCategory String? @map("sub_category")
  unit        String?
  /// Brand name (find-or-created on import).
  brand       String?
  price       Decimal @default(0) @db.Decimal(18, 4)
  cost        Decimal @default(0) @db.Decimal(18, 4)
  hsnCode     String? @map("hsn_code")
  /// Tax-rate name + its percentage (the rate lets import create it if absent).
  taxName     String? @map("tax_name")
  taxRate     Decimal? @map("tax_rate") @db.Decimal(9, 4)
  description String?
  genericName String? @map("generic_name")
  strength    String?
  /// Whether tenants may import this master (legacy `import_status`).
  isImportable Boolean @default(true) @map("is_importable")
  isActive    Boolean @default(true) @map("is_active")
  /// SiteAdmin id (from the SiteAdmin JWT) that created the master.
  createdBy   String? @map("created_by")

  // ── EZHT add-product parity (added migration 0023) ──
  /// branded|generic|standard|combo|digital|service.
  type        String  @default("standard")
  barcodeSymbology String? @default("code128") @map("barcode_symbology")
  /// Optional FK links to the SiteAdmin reference masters (coexist with the
  /// legacy string columns above, which the tenant-import path still uses).
  categoryId     String? @map("category_id")
  subCategoryId  String? @map("sub_category_id")
  unitId         String? @map("unit_id")
  brandId        String? @map("brand_id")
  taxRateId      String? @map("tax_rate_id")
  manufacturerId String? @map("manufacturer_id")
  packSize       String? @map("pack_size")
  /// INDIVIDUAL|PACK (legacy sales_method 0/1).
  salesMethod    String? @map("sales_method")
  packCost       Decimal? @map("pack_cost") @db.Decimal(18, 4)
  packMrp        Decimal? @map("pack_mrp") @db.Decimal(18, 4)
  /// INCLUSIVE|EXCLUSIVE.
  taxMethod         String? @map("tax_method")
  taxMethodPurchase String? @map("tax_method_purchase")
  alertQuantity  Decimal? @map("alert_quantity") @db.Decimal(18, 4)
  isTrackQuantity Boolean @default(true) @map("is_track_quantity")
  imageUrl       String? @map("image_url")
  galleryImageUrls String[] @map("gallery_image_urls")
  // Prescription fields (strength + genericName already above).
  composition   String?
  unitType      String? @map("unit_type")
  formulation   String?
  route         String?
  frequency     String?
  numberOfDays  String? @map("number_of_days")
  prescriptionQuantity String? @map("prescription_quantity")
  refills       String?
  refillTimes   String? @map("refill_times")
  prescriptionNotes String? @map("prescription_notes")
  // Custom fields cf1..cf11.
  cf1 String?
  cf2 String?
  cf3 String?
  cf4 String?
  cf5 String?
  cf6 String?
  cf7 String?
  cf8 String?
  cf9 String?
  cf10 String?
  cf11 String?
  /// Product details for invoice (legacy `details`; `description` = product details).
  invoiceDetails String? @map("invoice_details")
  hasVariants Boolean @default(false) @map("has_variants")
  /// Uploaded file URL for a digital product (legacy `digital_file`, type=digital).
  digitalFileUrl String? @map("digital_file_url")

  variants    InventoryMasterProductVariant[]
  suppliers   InventoryMasterProductSupplier[]
  comboItems  InventoryMasterComboItem[]
  drugs       InventoryMasterProductDrug[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@index([categoryId])
  @@index([manufacturerId])
  @@map("inventory_master_products")
}

/// A variant/option row of a master product.
model InventoryMasterProductVariant {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  name      String
  cost      Decimal @default(0) @db.Decimal(18, 4)
  price     Decimal @default(0) @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   InventoryMasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
  @@map("inventory_master_product_variants")
}

/// A supplier configuration row of a master product (EZHT caps at 5).
model InventoryMasterProductSupplier {
