  note       String?
  createdBy  String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items InventoryPurchaseReturnItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([purchaseId])
  @@index([deletedAt])
  @@map("inventory_purchase_returns")
}

/// A purchase-return line.
model InventoryPurchaseReturnItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  returnId    String  @map("return_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  quantity    Decimal @db.Decimal(18, 4)
  cost        Decimal @db.Decimal(18, 4)
  subtotal    Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  return InventoryPurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@index([productId])
  @@map("inventory_purchase_return_items")
}

/// A sale return (goods returned by the customer). Restocks + optional refund.
model InventorySaleReturn {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  branchId     String   @map("branch_id")
  saleId       String   @map("sale_id")
  reference    String
  date         DateTime
  total        Decimal  @default(0) @db.Decimal(18, 4)
  refundAmount Decimal  @default(0) @map("refund_amount") @db.Decimal(18, 4)
  note         String?
  createdBy    String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items InventorySaleReturnItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("inventory_sale_returns")
}

/// A sale-return line.
model InventorySaleReturnItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  returnId    String  @map("return_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  quantity    Decimal @db.Decimal(18, 4)
  price       Decimal @db.Decimal(18, 4)
  subtotal    Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  return InventorySaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@index([productId])
  @@map("inventory_sale_return_items")
}

/// A delivery record for a sale (legacy deliveries).
model InventorySaleDelivery {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  saleId     String   @map("sale_id")
  reference  String
  /// PENDING | DISPATCHED | DELIVERED.
  status     String   @default("PENDING")
  trackingNo String?  @map("tracking_no")
  deliveredTo String? @map("delivered_to")
  address    String?
  date       DateTime
  note       String?
  createdBy  String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("inventory_sale_deliveries")
}

/// A standalone operating expense (tied to an expense category).
model InventoryExpense {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  categoryId String?  @map("category_id")
  reference  String
  amount     Decimal  @db.Decimal(18, 4)
  date       DateTime
  note       String?
  createdBy  String?  @map("created_by")

  legacyExpenseId String? @map("legacy_expense_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("inventory_expenses")
}

/// A standalone (non-sale) income (tied to an income category).
model InventoryIncome {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  categoryId String?  @map("category_id")
  reference  String
  amount     Decimal  @db.Decimal(18, 4)
  date       DateTime
  note       String?
  createdBy  String?  @map("created_by")

  legacyIncomeId String? @map("legacy_income_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("inventory_incomes")
}

/// A gift card with a redeemable balance (legacy `ez_gift_cards`).
model InventoryGiftCard {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  branchId   String?   @map("branch_id")
  code       String
  value      Decimal   @db.Decimal(18, 4)
  balance    Decimal   @db.Decimal(18, 4)
  customerId String?   @map("customer_id")
  expiryDate DateTime? @map("expiry_date")
  /// ACTIVE | USED | EXPIRED | CANCELLED.
  status     String    @default("ACTIVE")
  note       String?

  legacyGiftCardId String? @map("legacy_gift_card_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@map("inventory_gift_cards")
}

// ── Blood cross-matching + IPD billing (clinical extensions) ──────────────────────

/// A cross-match between a blood request and a candidate donation unit.
model InventoryBloodCrossMatch {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  branchId    String?  @map("branch_id")
  requestId   String   @map("request_id")
  donationId  String   @map("donation_id")
  /// COMPATIBLE | INCOMPATIBLE.
  result      String
  /// True when derived from ABO/Rh rules, false when manually overridden.
  isAutoResult Boolean @default(true) @map("is_auto_result")
  note        String?
  crossMatchedBy String? @map("cross_matched_by")
  date        DateTime

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([requestId])
  @@index([donationId])
  @@index([deletedAt])
  @@map("inventory_blood_cross_matches")
}

/// A billable charge against an IPD admission (room, procedure, consumable…).
model InventoryIpdCharge {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  admissionId String   @map("admission_id")
  description String
  category    String?
  amount      Decimal  @db.Decimal(18, 4)
  date        DateTime
  createdBy   String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([admissionId])
  @@index([deletedAt])
  @@map("inventory_ipd_charges")
}

// ── Notifications, Calendar & cron (Phase 5/7) ────────────────────────────────

/// An in-app notification for a tenant (alerts, reminders, system messages).
model InventoryNotification {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String? @map("branch_id")
  /// Machine category: LOW_STOCK | EXPIRY | SYSTEM | INFO…
  type      String
  title     String
  body      String?
  /// Optional deep-link the frontend can route to (e.g. /products).
  link      String?
  isRead    Boolean @default(false) @map("is_read")
  /// De-duplication key so a recurring alert isn't re-created each run.
  dedupeKey String? @map("dedupe_key")

  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([isRead])
  @@index([dedupeKey])
  @@index([deletedAt])
  @@map("inventory_notifications")
}

/// A calendar event (reminders, appointments, follow-ups) — FullCalendar parity.
model InventoryCalendarEvent {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  branchId    String?  @map("branch_id")
  title       String
  description String?
  /// Event color (hex) for the calendar UI.
  color       String?
  startAt     DateTime @map("start_at")
  endAt       DateTime? @map("end_at")
  isAllDay    Boolean  @default(false) @map("is_all_day")
  createdBy   String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([startAt])
  @@index([deletedAt])
  @@map("inventory_calendar_events")
}

/// Platform-level registry of tenants with inventory activity. NOT tenant-scoped
/// and NOT under RLS — it is the enumeration source the cross-tenant alert cron
/// loops over (the inventory app does not own the kalnostics `tenants` table).
model InventoryTenantRegistry {
  tenantId   String   @id @map("tenant_id")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@map("inventory_tenant_registry")
}

// ── Parties & finance extensions (legacy parity) ──────────────────────────────

/// Customer deposit / advance ledger entry (legacy Customers::deposits).
model InventoryCustomerDeposit {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  /// DEPOSIT (add funds) | WITHDRAWAL (use funds) | ADJUSTMENT.
  type       String   @default("DEPOSIT")
  amount     Decimal  @db.Decimal(18, 4)
  note       String?
  date       DateTime
  createdBy  String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([customerId])
  @@index([deletedAt])
  @@map("inventory_customer_deposits")
}

/// A purchase expense (freight / insurance / misc) attached to a purchase
/// (legacy Purchases::expenses).
model InventoryPurchaseExpense {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  purchaseId String   @map("purchase_id")
  category   String?
  amount     Decimal  @db.Decimal(18, 4)
  reference  String?
  note       String?
  date       DateTime
  createdBy  String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([purchaseId])
  @@index([deletedAt])
  @@map("inventory_purchase_expenses")
}

/// A supplier-level payment (not tied to one purchase) — legacy
/// Purchases::supplier_payments.
model InventorySupplierPayment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  supplierId String   @map("supplier_id")
  amount     Decimal  @db.Decimal(18, 4)
  method     String   @default("CASH")
  reference  String?
  note       String?
  date       DateTime
  createdBy  String?  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([supplierId])
  @@index([deletedAt])
  @@map("inventory_supplier_payments")
}

/// A reusable email/message template (legacy System_settings email templates).
model InventoryEmailTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  subject   String?
  body      String?
  /// Free-form category (e.g. SALE, PURCHASE, GENERAL).
  type      String?
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@map("inventory_email_templates")
}

// ── Legacy-parity extensions (serials, held bills, promotions, templates) ─────

/// An individual product serial/IMEI unit (legacy serial tracking).
model InventoryProductSerial {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String? @map("branch_id")
  productId String  @map("product_id")
  serialNo  String  @map("serial_no")
  /// IN_STOCK | SOLD | RETURNED.
  status    String  @default("IN_STOCK")
  reference String?
  note      String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([serialNo])
  @@index([deletedAt])
  @@map("inventory_product_serials")
}

/// A suspended/held POS bill (legacy POS opened_bills). Cart stored as JSON.
model InventoryPosHeldBill {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String? @map("branch_id")
  label     String
  /// Held cart payload (line items + customer).
  cart      Json
  createdBy String? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("inventory_pos_held_bills")
}

/// A marketing promotion / banner (legacy Welcome promotions).
model InventoryPromotion {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  title       String
  description String?
  imageUrl    String?   @map("image_url")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  isActive    Boolean   @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@map("inventory_promotions")
}

/// A reusable product template (legacy SITE-level master_products). Copied into
/// real products via "create from template".
model InventoryProductTemplate {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String?
  name        String
  category    String?
  unit        String?
  price       Decimal @default(0) @db.Decimal(18, 4)
  cost        Decimal @default(0) @db.Decimal(18, 4)
  hsnCode     String? @map("hsn_code")
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@map("inventory_product_templates")
}
