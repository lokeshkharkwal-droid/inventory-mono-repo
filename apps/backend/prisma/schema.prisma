  batchNo      String?   @map("batch_no")
  serialNo     String?   @map("serial_no")
  expiryDate   DateTime? @map("expiry_date")
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(18, 4)
  netUnitPrice Decimal  @default(0) @map("net_unit_price") @db.Decimal(18, 4)
  realUnitPrice Decimal @default(0) @map("real_unit_price") @db.Decimal(18, 4)
  discountSpec String?  @map("discount_spec")
  discount     Decimal  @default(0) @db.Decimal(18, 4)
  taxRateId    String?  @map("tax_rate_id")
  taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount    Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  subtotal     Decimal  @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  requisition InventoryRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requisitionId])
  @@index([productId])
  @@index([batchId])
  @@map("inventory_requisition_items")
}

/// Status-change audit trail for a requisition (approval comments, legacy
/// `ez_comments`-style). Shown on the requisition detail/view.
model InventoryRequisitionStatusHistory {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  requisitionId String  @map("requisition_id")
  status        String
  comment       String?
  createdBy     String? @map("created_by")
  createdByName String? @map("created_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  requisition InventoryRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requisitionId])
  @@map("inventory_requisition_status_history")
}

// ── Settings master data (Phase 2) ──────────────────────────────────────────────

/// Currency — tenant-level (legacy `ez_currencies`). `exchangeRate` is relative
/// to the tenant's base currency.
model InventoryCurrency {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  code         String
  name         String
  symbol       String?
  exchangeRate Decimal @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  isActive     Boolean @default(true) @map("is_active")

  legacyCurrencyId String? @map("legacy_currency_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyCurrencyId])
  @@map("inventory_currencies")
}

/// Customer group — tenant-level price tier (legacy `ez_customer_groups`).
model InventoryCustomerGroup {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  code            String?
  name            String
  /// Percentage applied to base price for this group (+/-).
  percentage      Decimal @default(0) @db.Decimal(8, 4)
  isActive        Boolean @default(true) @map("is_active")

  legacyGroupId String? @map("legacy_group_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyGroupId])
  @@map("inventory_customer_groups")
}

/// Expense category — tenant-level (legacy expense categories).
model InventoryExpenseCategory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String?
  name     String
  isActive Boolean @default(true) @map("is_active")

  legacyCategoryId String? @map("legacy_category_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyCategoryId])
  @@map("inventory_expense_categories")
}

/// Income category — tenant-level (legacy income categories).
model InventoryIncomeCategory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String?
  name     String
  isActive Boolean @default(true) @map("is_active")

  legacyCategoryId String? @map("legacy_category_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyCategoryId])
  @@map("inventory_income_categories")
}

/// Biller — an invoice-issuing entity/company (legacy `ez_companies` group=biller).
model InventoryBiller {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String?
  name        String
  companyName String? @map("company_name")
  phone       String?
  email       String?
  address     String?
  taxNumber   String? @map("tax_number")
  logoUrl     String? @map("logo_url")
  isActive    Boolean @default(true) @map("is_active")

  legacyBillerId String? @map("legacy_biller_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyBillerId])
  @@map("inventory_billers")
}

/// Inventory settings — branch-scoped business settings + document numbering,
/// ported to full EZHealthTrack (SMA) parity. One row per (tenantId, branchId):
/// a `branchId = NULL` row is the tenant-level default (business-admin context)
/// and the template a branch's first-access row is cloned from. Uniqueness is
/// enforced in the DB via two partial unique indexes (migration 0059) because
/// Postgres treats NULLs as distinct in a plain compound unique index.
model InventorySetting {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  /// Branch this settings row applies to; NULL = tenant-level default.
  branchId            String? @map("branch_id")
  defaultCurrencyCode String? @map("default_currency_code")
  /// Allow stock to go negative (legacy `overselling`).
  isOversellingAllowed Boolean @default(false) @map("is_overselling_allowed")
  /// Block selling from an expired batch. Default off = expired batches sellable
  /// (the sale form warns); flip on to hard-reject expired-batch sales.
  isExpiredSaleBlocked Boolean @default(false) @map("is_expired_sale_blocked")
  rowsPerPage         Int     @default(20) @map("rows_per_page")
  decimalPlaces       Int     @default(2) @map("decimal_places")

  /// Document numbering prefixes (EZHT `*_prefix`).
  purchasePrefix      String  @default("PO") @map("purchase_prefix")
  salePrefix          String  @default("SALE") @map("sale_prefix")
  transferPrefix      String  @default("TR") @map("transfer_prefix")
  requisitionPrefix   String  @default("REQ") @map("requisition_prefix")
  quotePrefix         String  @default("QT") @map("quote_prefix")
  deliveryPrefix      String  @default("DO") @map("delivery_prefix")
  paymentPrefix       String  @default("PAY") @map("payment_prefix")
  transactionPrefix   String  @default("TXN") @map("transaction_prefix")
  returnPrefix        String  @default("RT") @map("return_prefix")
  expensePrefix       String  @default("EX") @map("expense_prefix")
  incomePrefix        String  @default("IN") @map("income_prefix")
  materialPrefix      String  @default("MAT") @map("material_prefix")
  productPrefix       String  @default("PRD") @map("product_prefix")
  /// Legacy EZHT reference number format (1 = date-based, 2 = sequential).
  referenceFormat     String? @map("reference_format")

  /// Default tax rates (EZHT `default_tax_rate` / `default_tax_rate2`).
  defaultProductTaxRateId String? @map("default_product_tax_rate_id")
  defaultOrderTaxRateId   String? @map("default_order_tax_rate_id")

  /// Localization / number formatting (EZHT).
  dateFormat            String?  @default("yyyy-mm-dd") @map("date_format")
  timezone              String?  @default("Asia/Kolkata") @map("timezone")
  localLanguage         String?  @map("local_language")
  decimalSeparator      String?  @default(".") @map("decimal_separator")
  thousandsSeparator    String?  @default(",") @map("thousands_separator")
  quantityDecimals      Int      @default(2) @map("quantity_decimals")
  currencySymbol        String?  @map("currency_symbol")
  isCurrencySymbolShown Boolean  @default(true) @map("is_currency_symbol_shown")
  /// South-Asian currency grouping (EZHT `sac`).
  isSacEnabled          Boolean  @default(false) @map("is_sac_enabled")

  /// Image / thumbnail sizing + watermark (EZHT `iwidth`/`iheight`/`twidth`/`theight`/`watermark`).
  imageWidth         Int?    @map("image_width")
  imageHeight        Int?    @map("image_height")
  thumbnailWidth     Int?    @map("thumbnail_width")
  thumbnailHeight    Int?    @map("thumbnail_height")
  isWatermarkEnabled Boolean @default(false) @map("is_watermark_enabled")

  /// Product & feature toggles (EZHT).
  isProductSerialEnabled   Boolean @default(false) @map("is_product_serial_enabled")
  isProductExpiryEnabled   Boolean @default(false) @map("is_product_expiry_enabled")
  isProductDiscountEnabled Boolean @default(false) @map("is_product_discount_enabled")
  isRacksEnabled           Boolean @default(false) @map("is_racks_enabled")
  isAttributesEnabled      Boolean @default(false) @map("is_attributes_enabled")
  /// Show all warehouse products incl. zero-stock (EZHT `display_all_products`).
  isAllProductsDisplayed   Boolean @default(false) @map("is_all_products_displayed")
  /// Auto-remove expired products (EZHT `remove_expired`).
  isExpiredRemoved         Boolean @default(false) @map("is_expired_removed")
  /// Reduce quotation sales (EZHT `quotation_sales_reducing`).
  isQuotationSalesReducing Boolean @default(false) @map("is_quotation_sales_reducing")

  /// Barcode settings (EZHT `auto_detect_barcode`/`barcode_separator`/`bc_fix`).
  isBarcodeAutoDetected Boolean @default(false) @map("is_barcode_auto_detected")
  barcodeSeparator      String? @map("barcode_separator")
  barcodeFixCount       Int     @default(0) @map("barcode_fix_count")

  /// Defaults (EZHT `default_warehouse`/`default_biller`/`default_supplier`).
  defaultWarehouseId String? @map("default_warehouse_id")
  defaultBillerId    String? @map("default_biller_id")
  defaultSupplierId  String? @map("default_supplier_id")

  /// Behaviour / limits (EZHT).
  itemAdditionMethod        String?  @map("item_addition_method")
  invoiceView               String?  @map("invoice_view")
  discountLimitPercentage   Decimal? @map("discount_limit_percentage") @db.Decimal(8, 4)
  discountLimitAmount       Decimal? @map("discount_limit_amount") @db.Decimal(25, 4)
  /// Days after which a document can no longer be edited (EZHT `disable_editing`).
  editingLockDays           Int      @default(0) @map("editing_lock_days")
  /// Default focus on the order page (EZHT `set_focus`).
  defaultOrderFocus         String?  @map("default_order_focus")
  isPurchaseRoundingEnabled Boolean  @default(false) @map("is_purchase_rounding_enabled")
  isSalesRoundingEnabled    Boolean  @default(false) @map("is_sales_rounding_enabled")
  /// Page shown after a sale (EZHT `after_sale_page`).
  afterSalePage             String?  @map("after_sale_page")
  expiryAlertDays           Int      @default(0) @map("expiry_alert_days")

  /// Optional POS cashier PIN for sensitive till actions (plain — low-security till PIN).
  posPin              String? @map("pos_pin")

  /// Business profile (name/address/phone/email) shown on documents.
  businessName    String? @map("business_name")
  businessAddress String? @map("business_address")
  businessPhone   String? @map("business_phone")
  businessEmail   String? @map("business_email")
  /// Per-tenant payment-gateway config (enabled flags / public keys). Secrets
  /// stay in env; this only holds non-secret toggles + display values.
  paymentGateways Json?   @map("payment_gateways")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([branchId])
  @@map("inventory_settings")
}

/// Per-tenant, per-role permission override. When a row exists for a
/// (tenantId, profileKey) pair, its `permissions` array is the role's EFFECTIVE
/// permission set in this tenant; absent → the code baseline applies. Lets an
/// admin grant/revoke permissions to a role at runtime (no redeploy).
model InventoryRolePermission {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  profileKey  String   @map("profile_key")
  /// Granted permission keys (`inventory:<section>__<action>`).
  permissions String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, profileKey])
  @@index([tenantId])
  @@map("inventory_role_permissions")
}

/// A custom, admin-created role (distinct from the built-in profile keys). Holds
/// its own permission set; assignable to users via InventoryUserRole.
model InventoryRole {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  /// Stable key used in resolution/assignment (e.g. `custom_warehouse_clerk`).
  key         String
  label       String
  permissions String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("inventory_roles")
}

/// Inventory-side role assignment: overrides the JWT profile for inventory
/// authorization. `roleKey` may be a built-in profile key or a custom role key.
model InventoryUserRole {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  personId  String   @map("person_id")
  roleKey   String   @map("role_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, personId])
  @@index([tenantId])
  @@map("inventory_user_roles")
}

// ── Quotes (Phase 3) ────────────────────────────────────────────────────────────

/// Sales or purchase quotation (legacy `ez_quotes`). No stock movement; can be
/// converted into a sale (or purchase).
model InventoryQuote {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  branchId      String?  @map("branch_id")
  /// SALE | PURCHASE.
  type          String   @default("SALE")
  /// Customer (SALE quotes) or supplier (PURCHASE quotes) — validated by service.
  customerId    String?  @map("customer_id")
  supplierId    String?  @map("supplier_id")
  reference     String
  date          DateTime
  /// DRAFT | SENT | APPROVED | REJECTED | CONVERTED.
  status        String   @default("DRAFT")
  subtotal      Decimal  @default(0) @db.Decimal(18, 4)
  orderTax      Decimal  @default(0) @map("order_tax") @db.Decimal(18, 4)
  orderDiscount Decimal  @default(0) @map("order_discount") @db.Decimal(18, 4)
  /// Original order-discount spec as entered ("5%" or "25") so edits round-trip.
  orderDiscountSpec String? @map("order_discount_spec")
  /// Order-level tax percentage as entered, so edits round-trip the rate (the
  /// `orderTax` column stores the resolved amount).
  orderTaxPercent Decimal? @map("order_tax_percent") @db.Decimal(8, 4)
  shipping      Decimal  @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(18, 4)
  note          String?
  // EZ Health Track "Add Quote" header parity.
  billerId        String?  @map("biller_id")
  warehouseId     String?  @map("warehouse_id")
  gstNumber       String?  @map("gst_number")
  gstState        String?  @map("gst_state")
  attachmentUrl   String?  @map("attachment_url")
  productDiscount Decimal  @default(0) @map("product_discount") @db.Decimal(18, 4)
  totalTax        Decimal  @default(0) @map("total_tax") @db.Decimal(18, 4)
  totalItems      Int      @default(0) @map("total_items")
  /// Referral sub-form snapshot: { sourceType, contactFname, contactMname, contactLname, businessName, businessAddress }.
  referralInfo    Json?    @map("referral_info")
  /// Id of the sale/purchase created when this quote was converted.
  convertedToId String?  @map("converted_to_id")
  createdBy     String?  @map("created_by")

  legacyQuoteId String? @map("legacy_quote_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items         InventoryQuoteItem[]
  statusHistory InventoryQuoteStatusHistory[]

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@index([legacyQuoteId])
  @@map("inventory_quotes")
}

/// A quote line.
model InventoryQuoteItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  quoteId     String  @map("quote_id")
  /// Null for a manual (off-catalogue) line — EZHT "add manual product".
  productId   String? @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  /// Batch / serial number for the quoted units (EZHT item serial).
  serialNo    String? @map("serial_no")
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  /// Original per-unit discount spec as entered ("10%" or "5") so edits round-trip.
  discountSpec String? @map("discount_spec")
  subtotal    Decimal @db.Decimal(18, 4)

  // EZ Health Track "Add Quote" line parity.
  netUnitPrice Decimal  @default(0) @map("net_unit_price") @db.Decimal(18, 4)
  packSize     String?  @map("pack_size")
  packQuantity Decimal? @map("pack_quantity") @db.Decimal(18, 4)
  productType  String?  @map("product_type")
  optionId     String?  @map("option_id")

  createdAt DateTime @default(now()) @map("created_at")

  quote InventoryQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@index([productId])
  @@map("inventory_quote_items")
}

/// Status-change trail for a quote (EZHT `comments_history` for quotes): records
/// each approve/reject/convert transition with an optional comment and actor.
model InventoryQuoteStatusHistory {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  quoteId       String  @map("quote_id")
  status        String
  comment       String?
  createdBy     String? @map("created_by")
  createdByName String? @map("created_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  quote InventoryQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("inventory_quote_status_history")
}

// ── Proformas (Phase 3) ──────────────────────────────────────────────────────────

/// Proforma invoice (legacy `ez_proformas`) — a pre-invoice document. `labTests`
/// holds optional lab/radiology lines (name + price) sourced from kalnostics; a
/// deeper live order integration is a later enhancement.
model InventoryProforma {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  branchId      String?  @map("branch_id")
  customerId    String?  @map("customer_id")
  /// Legacy EZHT proforma title/name (required on create).
  name          String?
  reference     String
  date          DateTime
  /// ACTIVE | INACTIVE (EZHT) — legacy DRAFT | SENT | INVOICED still accepted.
  status        String   @default("DRAFT")
  subtotal      Decimal  @default(0) @db.Decimal(18, 4)
  orderTax      Decimal  @default(0) @map("order_tax") @db.Decimal(18, 4)
  orderDiscount Decimal  @default(0) @map("order_discount") @db.Decimal(18, 4)
  shipping      Decimal  @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(18, 4)
  /// Optional lab/radiology lines: [{ name, price }].
  labTests      Json?    @map("lab_tests")
  note          String?
  createdBy     String?  @map("created_by")

  legacyProformaId String? @map("legacy_proforma_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items     InventoryProformaItem[]
  relations InventoryProformaRelation[]

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@index([legacyProformaId])
  @@map("inventory_proformas")
}

/// A proforma line (product).
model InventoryProformaItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  proformaId  String  @map("proforma_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productCode String? @map("product_code")
  quantity    Decimal @db.Decimal(18, 4)
  /// 1 = Single (separate line); 2 = Combined (merge qty on re-add).
  quantityMethod Int  @default(1) @map("quantity_method")
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  subtotal    Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  proforma InventoryProforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([proformaId])
  @@index([productId])
  @@map("inventory_proforma_items")
}

/// Generic proforma ↔ external-entity mapping (legacy EZHT `ez_proforma_relation`).
/// `entityType` selects the catalogue the `entityId` points at:
///   - `lab_test`              → a kalnostics-new master `LabTest.id` (consumption trigger)
///   - `branch`                → a kalnostics-new `Branch.id` the proforma is enabled at
///   - `radiology`             → reserved (kalnostics radiology not yet wired) — DISABLED in UI
///   - `blood_donation_type`   → reserved — DISABLED in UI
///   - `blood_request_type`    → reserved — DISABLED in UI
/// A proforma consumes inventory for a lab test only when it is ALSO mapped to the
/// order's active branch (requirement #13). Soft-deletable; de-duplicated per
/// (proforma, entityType, entityId) among live rows.
model InventoryProformaRelation {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  branchId   String? @map("branch_id")
  proformaId String  @map("proforma_id")
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  /// Snapshot of the entity's display name (lab test / branch name) for listing.
  label      String?
  createdBy  String? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  proforma InventoryProforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([proformaId])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("inventory_proforma_relations")
}

/// Idempotency + audit ledger for inventory consumed by a confirmed kalnostics-new
/// order. One row per kalnostics `Order` (unique) — created the first time the
/// order's proforma-mapped products are deducted, guaranteeing stock is never
/// deducted twice and at most one linked sale exists. `saleId` points at the
/// `InventorySale` auto-generated for the consumption.
model InventoryOrderConsumption {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  branchId          String  @map("branch_id")
  /// The kalnostics-new `Order.id` that triggered the consumption (idempotency key).
  kalnosticsOrderId String  @unique @map("kalnostics_order_id")
  /// The kalnostics order code (e.g. `ORD-00001`) — sale reference + audit.
  orderCode         String? @map("order_code")
  saleId            String? @map("sale_id")
  /// CONSUMED (auto deduction done) | PENDING_MANUAL (auto off, awaiting first
  /// manual save) | ADJUSTED (a manual adjustment has been applied).
  status            String  @default("CONSUMED")
  /// ORDER | TEST — the granularity at which this order's deduction ledger is kept
  /// (fixed when the consumption row is first created; follows the tenant's
  /// manual-adjustment mode at that time).
  scope             String  @default("ORDER")
  /// Whether stock was auto-deducted at order creation. false = deduction deferred
  /// to the first manual adjustment save.
  isAutoDeducted    Boolean @default(true) @map("is_auto_deducted")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([saleId])
  @@map("inventory_order_consumptions")
}

/// Authoritative per-scope, per-product "currently deducted" state for a kalnostics
/// order's inventory consumption. One row per (order, scope, lab test, product):
/// for ORDER scope `labTestSourceId` is the '' sentinel; for TEST scope it is the
/// master `LabTest.id`. Both auto-consumption and manual adjustment converge on
/// `currentQty` here — a save applies `delta = finalQty − currentQty`, so stock is
/// never double-deducted and repeated saves converge. `plannedQty` is the proforma
/// math for reference.
model InventoryConsumptionLine {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  branchId          String  @map("branch_id")
  scope             String
  kalnosticsOrderId String  @map("kalnostics_order_id")
  labTestSourceId   String  @default("") @map("lab_test_source_id")
  productId         String  @map("product_id")
  productName       String  @map("product_name")
  productCode       String? @map("product_code")
  plannedQty        Decimal @default(0) @map("planned_qty") @db.Decimal(18, 4)
  currentQty        Decimal @default(0) @map("current_qty") @db.Decimal(18, 4)
  unitPrice         Decimal @default(0) @map("unit_price") @db.Decimal(18, 4)
  taxRate           Decimal @default(0) @map("tax_rate") @db.Decimal(8, 4)
  consumptionId     String  @map("consumption_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([kalnosticsOrderId, scope, labTestSourceId, productId], name: "consumption_line_scope_key")
  @@index([tenantId])
  @@index([branchId])
  @@index([consumptionId])
  @@index([kalnosticsOrderId])
  @@index([productId])
  @@map("inventory_consumption_lines")
}

/// Immutable audit row: one per product whose deducted quantity changed on a manual
/// adjustment save. Records planned/previous/final/difference + who/when/why, for a
/// complete adjustment history.
model InventoryConsumptionAdjustment {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  branchId          String  @map("branch_id")
  consumptionId     String  @map("consumption_id")
  scope             String
  kalnosticsOrderId String  @map("kalnostics_order_id")
  labTestSourceId   String  @default("") @map("lab_test_source_id")
  productId         String  @map("product_id")
  productName       String  @map("product_name")
  plannedQty        Decimal @default(0) @map("planned_qty") @db.Decimal(18, 4)
  previousQty       Decimal @default(0) @map("previous_qty") @db.Decimal(18, 4)
  finalQty          Decimal @default(0) @map("final_qty") @db.Decimal(18, 4)
  /// The signed stock delta applied by this save (`finalQty − previousQty`).
  difference        Decimal @default(0) @db.Decimal(18, 4)
  reason            String?
  note              String?
  createdBy         String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([consumptionId])
  @@index([kalnosticsOrderId])
  @@index([productId])
  @@map("inventory_consumption_adjustments")
}

// ── Materials (Phase 3) ──────────────────────────────────────────────────────────

/// Consumable / equipment material tracked simply per branch (legacy
/// `ez_materials`). Separate from the product catalogue.
model InventoryMaterial {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  code       String?
  name       String
  category   String?
  unit       String?
  quantity   Decimal  @default(0) @db.Decimal(18, 4)
  cost       Decimal  @default(0) @db.Decimal(18, 4)
  note       String?
  isActive   Boolean  @default(true) @map("is_active")

  // EZ Health Track "Add Material" (asset register) parity fields.
  entryDate            DateTime? @map("entry_date")
  purchaseOrderNo      String?   @map("purchase_order_no")
  billerId             String?   @map("biller_id")
  warehouseId          String?   @map("warehouse_id")
  department           String?
  departmentRoom       String?   @map("department_room")
  sellerName           String?   @map("seller_name")
  purchaseDate         DateTime? @map("purchase_date")
  installationDate     DateTime? @map("installation_date")
  materialStatus       String?   @map("material_status")
  grandTotal           Decimal?  @map("grand_total") @db.Decimal(18, 4)
  amcCost              Decimal?  @map("amc_cost") @db.Decimal(18, 4)
  cmcCost              Decimal?  @map("cmc_cost") @db.Decimal(18, 4)
  estimatedPresentCost Decimal?  @map("estimated_present_cost") @db.Decimal(18, 4)
  codalLife            String?   @map("codal_life")
  amcStatus            String?   @map("amc_status")
  amcStartDate         DateTime? @map("amc_start_date")
  amcEndDate           DateTime? @map("amc_end_date")
  issueTo              String?   @map("issue_to")
  transferTo           String?   @map("transfer_to")
  documentUrl          String?   @map("document_url")
  staffNote            String?   @map("staff_note")

  /// Person UUID of the staff member who created this material (from the JWT).
  createdBy String? @map("created_by")

  legacyMaterialId String? @map("legacy_material_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  damages InventoryMaterialDamage[]
  repairs InventoryMaterialRepair[]

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@index([legacyMaterialId])
  @@map("inventory_materials")
}

/// A recorded material damage/loss.
model InventoryMaterialDamage {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  materialId String   @map("material_id")
