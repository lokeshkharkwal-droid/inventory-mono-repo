  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  subCategories InventoryMasterSubCategory[]

  @@index([deletedAt])
  @@map("inventory_master_categories")
}

/// Platform-level canonical SUB-CATEGORY (belongs to a master category).
model InventoryMasterSubCategory {
