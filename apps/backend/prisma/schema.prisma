// inventory-backend Prisma schema.
//
// OWNERSHIP BOUNDARY (see Master plan §3.3): this schema manages ONLY the
// `inventory_*` tables inside the SHARED kalnostics-new PostgreSQL database.
// kalnostics-owned tables (tenants, branches, patients, orders, …) are NOT
// declared or migrated here — inventory references them by id and reads them at
// runtime through the kalnostics-new API (the IntegrationModule).
//
// Conventions (CLAUDE.md §3–§4): PascalCase singular models → snake_case plural
// tables via @@map; snake_case columns via @map; UUID PKs; createdAt/updatedAt/
// deletedAt on every model; tenantId (+ @@index) on tenant-scoped models;
// nullable branchId (+ @@index) on branch-level models; booleans is/has/can-
// prefixed; `legacy*` columns to make the MySQL→Postgres migration idempotent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Product category — tenant-level master data (not per-warehouse), mirroring
/// the legacy `ez_categories` table. Subcategories arrive as a separate model in
/// Phase 1.
model InventoryCategory {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  /// Short code shown on lists / used in imports (unique per tenant when set).
  code        String?
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  /// Display ordering on pickers/lists.
  sortOrder   Int     @default(0) @map("sort_order")

  /// Provenance for the legacy MySQL migration (idempotent re-runs).
  legacyCategoryId String? @map("legacy_category_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyCategoryId])
  @@map("inventory_categories")

  subCategories InventorySubCategory[]
  products      InventoryProduct[]
}

/// Product sub-category — tenant-level, nested under a category (legacy
/// `ez_subcategories`).
model InventorySubCategory {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  categoryId  String  @map("category_id")
  code        String?
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  legacySubCategoryId String? @map("legacy_sub_category_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category InventoryCategory @relation(fields: [categoryId], references: [id])
  products InventoryProduct[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([legacySubCategoryId])
  @@map("inventory_sub_categories")
}

/// Unit of measure — tenant-level master data with optional base-unit conversion
/// (legacy `ez_units`: base_unit + operator `*`/`/` + operation_value).
model InventoryUnit {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  code       String?
  name       String
  /// Optional base unit for conversion (self-relation).
  baseUnitId String?  @map("base_unit_id")
  /// Conversion operator against the base unit: '*' or '/'.
  operator   String?
  /// Conversion factor applied with `operator` to reach the base unit.
  operationValue Decimal? @map("operation_value") @db.Decimal(18, 6)
  isActive   Boolean  @default(true) @map("is_active")

  legacyUnitId String? @map("legacy_unit_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  baseUnit    InventoryUnit?  @relation("UnitBase", fields: [baseUnitId], references: [id])
  derivedUnits InventoryUnit[] @relation("UnitBase")
  products     InventoryProduct[]

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyUnitId])
  @@map("inventory_units")
}

/// Brand / manufacturer — tenant-level master data (legacy `ez_brands`).
model InventoryBrand {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String?
  name        String
  description String?
  /// Logo/image URL (stored via the shared uploads service).
  imageUrl    String? @map("image_url")
  isActive    Boolean @default(true) @map("is_active")

  legacyBrandId String? @map("legacy_brand_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products InventoryProduct[]

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyBrandId])
  @@map("inventory_brands")
}

/// Manufacturer — a company/party master (legacy `companies` group_name=manufacturer).
/// Distinct from Brand (a product attribute): this is a maker organisation with a
/// logo and contact details.
model InventoryManufacturer {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String?
  name        String
  companyName String? @map("company_name")
  phone       String?
  email       String?
  website     String?
  address     String?
  /// Logo/image URL (stored via the shared uploads service).
  imageUrl    String? @map("image_url")
  note        String?
  isActive    Boolean @default(true) @map("is_active")

  // EZ Health Track "Add Manufacturer" parity fields.
  contactPerson String? @map("contact_person")
  vatNo         String? @map("vat_no")
  countryId     String? @map("country_id")
  stateId       String? @map("state_id")
  cityId        String? @map("city_id")
  city          String?
  state         String?
  postalCode    String? @map("postal_code")
  country       String?
  invoiceFooter String? @map("invoice_footer")
  cf1           String?
  cf2           String?
  cf3           String?
  cf4           String?
  cf5           String?
  cf6           String?

  legacyManufacturerId String? @map("legacy_manufacturer_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products InventoryProduct[]

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyManufacturerId])
  @@map("inventory_manufacturers")
}

/// Tax rate — tenant-level master data with HSN/SAC (legacy `ez_tax_rates`).
model InventoryTaxRate {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String?
  name     String
  /// The rate value; interpreted by `type`.
  rate     Decimal @db.Decimal(8, 4)
  /// 'percentage' (default) or 'fixed'.
  type     String  @default("percentage")
  /// HSN/SAC code (India GST).
  hsnCode  String? @map("hsn_code")
  isActive Boolean @default(true) @map("is_active")

  legacyTaxRateId String? @map("legacy_tax_rate_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products InventoryProduct[]

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyTaxRateId])
  @@map("inventory_tax_rates")
}

/// Variant/option template — tenant-level (legacy `ez_variants`). `values` holds
/// the option values (e.g. Size → [S, M, L]); per-product variants live on the
/// product in Phase 1b.
model InventoryVariant {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  name     String
  values   String[]
  isActive Boolean  @default(true) @map("is_active")

  legacyVariantId String? @map("legacy_variant_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacyVariantId])
  @@map("inventory_variants")
}

/// Product — tenant-level catalogue item (legacy `ez_products`). Stock is held
/// per branch in InventoryWarehouseProduct (branch = warehouse).
model InventoryProduct {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  code          String
  name          String
  categoryId    String  @map("category_id")
  subCategoryId String? @map("sub_category_id")
  unitId        String? @map("unit_id")
  brandId       String? @map("brand_id")
  /// Manufacturer link (EZHT add-product `manufacturer1`).
  manufacturerId String? @map("manufacturer_id")
  taxRateId     String? @map("tax_rate_id")
  /// STANDARD | COMBO | SERVICE.
  type          String  @default("STANDARD")
  cost          Decimal @default(0) @db.Decimal(18, 4)
  price         Decimal @default(0) @db.Decimal(18, 4)
  /// Reorder alert threshold.
  alertQuantity Decimal @default(0) @map("alert_quantity") @db.Decimal(18, 4)
  /// Whether stock is tracked (false = service/non-stock item).
  isStockTracked Boolean @default(true) @map("is_stock_tracked")
  /// Whether the price already includes tax.
  isTaxIncluded Boolean @default(false) @map("is_tax_included")
  isActive      Boolean @default(true) @map("is_active")
  barcodeSymbology String? @map("barcode_symbology")
  imageUrl      String? @map("image_url")
  /// Additional gallery image URLs (EZHT parity).
  galleryImageUrls String[] @map("gallery_image_urls")
  description   String?
  /// Pharmaceutical metadata (optional).
  genericName   String? @map("generic_name")
  strength      String?
  /// Homoeopathy potency (e.g. 30C, 200CH) + HSN/SAC code.
  potency       String?
  hsnCode       String? @map("hsn_code")
  /// Track individual serial numbers for this product.
  isSerialized  Boolean @default(false) @map("is_serialized")

  // ── EZHT business add-product parity (migration 0025) ──
  packSize          String? @map("pack_size")
  /// INDIVIDUAL | PACK.
  salesMethod       String? @map("sales_method")
  packCost          Decimal? @map("pack_cost") @db.Decimal(18, 4)
  packMrp           Decimal? @map("pack_mrp") @db.Decimal(18, 4)
  /// INCLUSIVE | EXCLUSIVE.
  taxMethod         String? @map("tax_method")
  taxMethodPurchase String? @map("tax_method_purchase")
  // Prescription fields (strength + genericName already above).
  composition          String?
  unitType             String? @map("unit_type")
  formulation          String?
  route                String?
  frequency            String?
  numberOfDays         String? @map("number_of_days")
  prescriptionQuantity String? @map("prescription_quantity")
  refills              String?
  refillTimes          String? @map("refill_times")
  prescriptionNotes    String? @map("prescription_notes")
  // Custom fields cf1..cf11 (EZHT labels) + invoice details.
  cf1 String?
  cf2 String?
  cf3 String?
  cf4 String?
  cf5 String?
  cf6 String?
  cf7 String?
  cf8 String?
  cf9 String?
  cf10 String?
  cf11 String?
  /// Product details for invoice (EZHT `details`; `description` = product details).
  invoiceDetails String? @map("invoice_details")

  legacyProductId String? @map("legacy_product_id")
  /// When imported from the global master catalogue, the source master id.
  sourceMasterProductId String? @map("source_master_product_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category    InventoryCategory     @relation(fields: [categoryId], references: [id])
  subCategory InventorySubCategory? @relation(fields: [subCategoryId], references: [id])
  unit        InventoryUnit?        @relation(fields: [unitId], references: [id])
  brand       InventoryBrand?       @relation(fields: [brandId], references: [id])
  manufacturer InventoryManufacturer? @relation(fields: [manufacturerId], references: [id])
  taxRate     InventoryTaxRate?     @relation(fields: [taxRateId], references: [id])

  variants       InventoryProductVariant[]
  warehouseStocks InventoryWarehouseProduct[]
  suppliers      InventoryProductSupplier[]
  adjustments    InventoryStockAdjustment[]
  batches        InventoryProductBatch[]
  serials        InventoryProductSerial[]
  drugs          InventoryProductDrug[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([categoryId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([deletedAt])
  @@index([legacyProductId])
  @@index([sourceMasterProductId])
  @@map("inventory_products")
}

/// A product variant/option (e.g. a specific size), with price/cost deltas.
model InventoryProductVariant {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  productId      String  @map("product_id")
  name           String
  sku            String?
  costAdjustment Decimal @default(0) @map("cost_adjustment") @db.Decimal(18, 4)
  priceAdjustment Decimal @default(0) @map("price_adjustment") @db.Decimal(18, 4)

  legacyVariantId String? @map("legacy_variant_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product InventoryProduct @relation(fields: [productId], references: [id])
  warehouseStocks InventoryVariantWarehouseProduct[]

  @@index([tenantId])
  @@index([productId])
  @@index([deletedAt])
  @@map("inventory_product_variants")
}

/// Per-variant per-branch stock (legacy "attributes"/product_options: a variant
/// row carries a warehouse + quantity + cost). Tenant-scoped.
model InventoryVariantWarehouseProduct {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  variantId String   @map("variant_id")
  branchId  String   @map("branch_id")
  quantity  Decimal  @default(0) @db.Decimal(18, 4)
  cost      Decimal? @db.Decimal(18, 4)
  rack      String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  variant InventoryProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, branchId])
  @@index([tenantId])
  @@index([variantId])
  @@index([branchId])
  @@map("inventory_variant_warehouse_products")
}

/// A product↔supplier link with part number + price (legacy supplier1..5). Capped
/// at 5 per product by the service. Tenant-scoped.
model InventoryProductSupplier {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  productId  String   @map("product_id")
  supplierId String   @map("supplier_id")
  partNumber String?  @map("part_number")
  price      Decimal? @db.Decimal(18, 4)
  sortOrder  Int      @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product  InventoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier InventorySupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@map("inventory_product_suppliers")
}

/// Per-branch (warehouse) stock for a product: on-hand quantity + average cost +
/// rack location (legacy `ez_warehouses_products`). Branch = warehouse.
model InventoryWarehouseProduct {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String  @map("branch_id")
  productId String  @map("product_id")
  quantity  Decimal @default(0) @db.Decimal(18, 4)
  avgCost   Decimal @default(0) @map("avg_cost") @db.Decimal(18, 4)
  rack      String?

  // ── Branch-level inventory state (set by quantity adjustments; migration 0044) ──
  // The product is tenant-level, but each branch manages its own pricing/batch.
  // These hold the "current" per-branch values surfaced in the branch-scoped list.
  packSize     String?   @map("pack_size")
  packQuantity Decimal?  @map("pack_quantity") @db.Decimal(18, 4)
  unitMrp      Decimal?  @map("unit_mrp") @db.Decimal(18, 4)
  packMrp      Decimal?  @map("pack_mrp") @db.Decimal(18, 4)
  batchNo      String?   @map("batch_no")
  expiryDate   DateTime? @map("expiry_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product InventoryProduct @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@map("inventory_warehouse_products")
}

/// A manual stock adjustment at a branch (addition/subtraction with a reason)
/// (legacy quantity adjustments).
model InventoryStockAdjustment {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String  @map("branch_id")
  productId String  @map("product_id")
  /// Signed quantity delta (positive = addition, negative = subtraction).
  quantity  Decimal @db.Decimal(18, 4)
  /// ADDITION | SUBTRACTION (mirrors the sign of `quantity`).
  type      String
  reason    String?
  note      String?
  createdBy String? @map("created_by")

  // ── EZHT full-adjustment parity (migration 0025) ──
  /// Effective adjustment date (defaults to createdAt when omitted).
  adjustedAt   DateTime? @map("adjusted_at")
  /// Optional product variant this adjustment applies to.
  variantId    String?   @map("variant_id")
  packSize     String?   @map("pack_size")
  packQuantity Decimal?  @map("pack_quantity") @db.Decimal(18, 4)
  batchNo      String?   @map("batch_no")
  expiryDate   DateTime? @map("expiry_date")
  packMrp      Decimal?  @map("pack_mrp") @db.Decimal(18, 4)
  unitMrp      Decimal?  @map("unit_mrp") @db.Decimal(18, 4)

  /// The product batch this adjustment targeted (the "Purchased Item" picked in
  /// the Adjust Quantity modal). Its balance moves with the warehouse total so
  /// SUM(open batch.quantity) == warehouse.quantity; null for untargeted adjustments.
  batchId      String?   @map("batch_id")

  legacyAdjustmentId String? @map("legacy_adjustment_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product InventoryProduct @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@index([deletedAt])
  @@map("inventory_stock_adjustments")
}

/// A drug-composition row of a product (EZHT "Drugs" modal / legacy
/// `ez_product_relation`): a link to a master drug + unit value + unit.
/// Tenant-scoped, soft-deletable (delete + re-activate parity). `name` is a
/// denormalized snapshot of the master drug's name at link time; `drugId` is
/// null for legacy free-text rows created before the master existed.
model InventoryProductDrug {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  productId String  @map("product_id")
  drugId    String? @map("drug_id")
  name      String
  unitValue String? @map("unit_value")
  unit      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  drug      InventoryDrug?   @relation(fields: [drugId], references: [id])
  @@index([tenantId])
  @@index([productId])
  @@index([drugId])
  @@index([deletedAt])
  @@map("inventory_product_drugs")
}

/// Tenant drug master (EZHT `pharmacy_drug`) — the catalogue the "Drugs" modal
/// autocomplete picks from. Tenant-scoped, soft-delete aware.
model InventoryDrug {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  name              String
  dosage            String?
  sideEffect        String? @map("side_effect")
  indication        String?
  contraIndication  String? @map("contra_indication")
  formulation       String?
  storageCondition  String? @map("storage_condition")
  precaution        String?
  safety            String?
  therapeuticGroup  String? @map("therapeutic_group")
  isActive          Boolean @default(true) @map("is_active")
  legacyDrugId      String? @map("legacy_drug_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  productDrugs InventoryProductDrug[]
  @@index([tenantId])
  @@index([name])
  @@index([deletedAt])
  @@map("inventory_drugs")
}

/// Product batch / serial with expiry, per branch (legacy `ez_product_serials`).
model InventoryProductBatch {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  branchId   String    @map("branch_id")
  productId  String    @map("product_id")
  batchNo    String?   @map("batch_no")
  serialNo   String?   @map("serial_no")
  expiryDate DateTime? @map("expiry_date")
  quantity   Decimal   @default(0) @db.Decimal(18, 4)
  cost       Decimal?  @db.Decimal(18, 4)

  /// The purchase (header) whose receipt created this batch. Stable across purchase
  /// edits (items are replaced but the purchase id is not), so a purchase edit can
  /// reconcile exactly the batches it owns. Null for adjustment/backfill batches.
  sourcePurchaseId String? @map("source_purchase_id")

  legacySerialId String? @map("legacy_serial_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product   InventoryProduct    @relation(fields: [productId], references: [id])
  saleItems InventorySaleItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@index([expiryDate])
  @@index([deletedAt])
  @@index([tenantId, branchId, productId, deletedAt])
  @@index([sourcePurchaseId])
  @@map("inventory_product_batches")
}

// ── Parties ───────────────────────────────────────────────────────────────────

/// Supplier / vendor — tenant-level (legacy `ez_companies` group=supplier).
model InventorySupplier {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String?
  name           String
  companyName    String? @map("company_name")
  phone          String?
  email          String?
  address        String?
  taxNumber      String? @map("tax_number")
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(18, 4)
  isActive       Boolean @default(true) @map("is_active")

  // EZ Health Track "Add Supplier" parity fields.
  type          String? // company | person
  contactPerson String? @map("contact_person")
  // Location: canonical SiteAdmin ids (for dependent dropdowns) + display names.
  countryId     String? @map("country_id")
  stateId       String? @map("state_id")
  cityId        String? @map("city_id")
  country       String?
  state         String?
  city          String?
  postalCode    String? @map("postal_code")
  drugLicense   String? @map("drug_license")
  vatNo         String? @map("vat_no")
  gstNo         String? @map("gst_no")
  panNo         String? @map("pan_no")
  gstState      String? @map("gst_state")
  cf1           String?
  cf2           String?
  cf3           String?
  cf4           String?
  cf5           String?
  cf6           String?

  legacySupplierId String? @map("legacy_supplier_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  purchases       InventoryPurchase[]
  productSuppliers InventoryProductSupplier[]

  @@index([tenantId])
  @@index([deletedAt])
  @@index([legacySupplierId])
  @@map("inventory_suppliers")
}

/// Customer — tenant-level (legacy `ez_companies` group=customer). Clinical
/// customers may link to a kalnostics patient via `patientId` (resolved by API).
model InventoryCustomer {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String?
  name        String
  companyName String?  @map("company_name")
  phone       String?
  email       String?
  address     String?
  taxNumber   String?  @map("tax_number")
  creditLimit Decimal? @map("credit_limit") @db.Decimal(18, 4)
  /// Optional link to a kalnostics Patient (id only; details fetched via API).
  patientId   String?  @map("patient_id")
  /// Accrued loyalty/award points (legacy award_points).
  loyaltyPoints Int    @default(0) @map("loyalty_points")
  /// The existing customer who referred this one (legacy referral suggestions).
