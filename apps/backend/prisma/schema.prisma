  createdBy String? @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("inventory_master_units")
}

/// Platform-level canonical BRAND (SiteAdmin-managed).
model InventoryMasterBrand {
  id        String  @id @default(uuid())
  name      String
  code      String?
  isActive  Boolean @default(true) @map("is_active")
  createdBy String? @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("inventory_master_brands")
}

/// Platform-level canonical TAX RATE (SiteAdmin-managed). Full EZHT parity:
/// name/code/rate/type + HSN + CGST/SGST/IGST breakdown.
model InventoryMasterTaxRate {
  id        String   @id @default(uuid())
  name      String
  rate      Decimal  @default(0) @db.Decimal(9, 4)
  code      String?
  /// Tax type — EZHT only exposes "percentage".
  type      String   @default("percentage")
  hsnCode   String?  @map("hsn_code")
  cgst      Decimal? @db.Decimal(9, 4)
  sgst      Decimal? @db.Decimal(9, 4)
  igst      Decimal? @db.Decimal(9, 4)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  expenseCategories InventoryMasterExpenseCategory[] @relation("MasterExpenseCategoryTax")
  incomeCategories  InventoryMasterIncomeCategory[]  @relation("MasterIncomeCategoryTax")

  @@index([deletedAt])
  @@map("inventory_master_tax_rates")
}

/// Platform-level canonical VARIANT option (SiteAdmin-managed).
model InventoryMasterVariant {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
