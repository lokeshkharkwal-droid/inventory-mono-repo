meta {
  name: Create event
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/calendar/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Follow up with supplier",
    "startAt": "2026-12-01T09:00:00.000Z",
    "color": "#6366f1"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
