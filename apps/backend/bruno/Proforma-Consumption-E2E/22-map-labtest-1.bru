meta {
  name: 22 Map proforma to lab test 1
  type: http
  seq: 9
}

post {
  url: {{inventoryBaseUrl}}/proformas/{{proformaId}}/relations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "entityType": "lab_test",
    "entityId": "{{labTest1}}",
    "label": "Lab Test 1"
  }
}

assert {
  res.status: eq 201
}
