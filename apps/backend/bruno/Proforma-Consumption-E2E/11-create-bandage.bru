meta {
  name: 11 Create product - Bandage
  type: http
  seq: 4
}

post {
  url: {{inventoryBaseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "BRU-BAN-{{runSfx}}",
    "name": "Bruno Bandage {{runSfx}}",
    "categoryId": "{{categoryId}}",
    "cost": 8,
    "price": 15,
    "alertQuantity": 3
  }
}

script:post-response {
  if (res.body.data) bru.setEnvVar("bandageId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.id: isString
}
