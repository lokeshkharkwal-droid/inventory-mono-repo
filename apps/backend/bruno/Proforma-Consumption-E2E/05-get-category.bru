meta {
  name: 05 Get a category id
  type: http
  seq: 2
}

get {
  url: {{inventoryBaseUrl}}/categories?page=1&limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.body.data && res.body.data.length) {
    bru.setEnvVar("categoryId", res.body.data[0].id);
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

tests {
  test("a category exists", function () {
    expect(res.body.data.length).to.be.greaterThan(0);
  });
}

docs {
  Products require a categoryId. Captures the first tenant category for the two
  test products below.
}
