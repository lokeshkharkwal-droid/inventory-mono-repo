meta {
  name: 25 Map proforma to lab test 4
  type: http
  seq: 12
}

post {
  url: {{inventoryBaseUrl}}/proformas/{{proformaId}}/relations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "entityType": "lab_test",
    "entityId": "{{labTest4}}",
    "label": "Lab Test 4"
  }
}

assert {
  res.status: eq 201
}
