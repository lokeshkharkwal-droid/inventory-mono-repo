meta {
  name: 00 Switch to branch A
  type: http
  seq: 1
}

post {
  url: {{kalnosticsBaseUrl}}/auth/switch-profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "profileKey": "{{profileKey}}",
    "branchId": "{{branchA}}"
  }
}

script:pre-request {
  // A per-run suffix keeps product codes, the order id, AND the lab-test ids
  // unique on re-runs. Run-unique lab-test ids are essential: mappings persist in
  // the DB, so reusing the same ids would make a later run match earlier runs'
  // proformas at the same branch. Each run maps + consumes its own fresh ids.
  var sfx = String(Date.now());
  bru.setEnvVar("runSfx", sfx);
  bru.setEnvVar("orderId", "BRU-ORDER-" + sfx);
  for (var i = 1; i <= 5; i++) bru.setEnvVar("labTest" + i, "LT-" + sfx + "-" + i);
}

script:post-response {
  if ((res.status === 200 || res.status === 201) && res.body.data) {
    bru.setEnvVar("token", res.body.data.accessToken);
    if (res.body.data.refreshToken) bru.setEnvVar("refreshToken", res.body.data.refreshToken);
  }
}

assert {
  res.status: eq 200
  res.body.data.accessToken: isString
}

tests {
  test("active branch is branch A", function () {
    const jwt = res.body.data.accessToken.split(".")[1];
    const payload = JSON.parse(Buffer.from(jwt, "base64").toString("utf8"));
    expect(payload.active_branch_id).to.equal(bru.getEnvVar("branchA"));
  });
}

docs {
  Switches the active branch to branch A and refreshes the token. Seeding stock via
  adjustments uses the token's ACTIVE branch, so this must run before stock seeding.
  Also sets a per-run suffix + the idempotency order id.
}
