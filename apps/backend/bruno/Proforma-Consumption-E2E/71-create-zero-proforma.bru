meta {
  name: 71 Create proforma for zero-stock product
  type: http
  seq: 24
}

post {
  url: {{inventoryBaseUrl}}/proformas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno Zero Proforma {{runSfx}}",
    "items": [
      { "productId": "{{zeroProductId}}", "quantity": 1, "unitPrice": 10, "quantityMethod": 1 }
    ]
  }
}

script:post-response {
  if (res.body.data) bru.setEnvVar("zeroProformaId", res.body.data.id);
}

assert {
  res.status: eq 201
}
