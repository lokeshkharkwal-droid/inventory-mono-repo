meta {
  name: 26 Map proforma to lab test 5
  type: http
  seq: 13
}

post {
  url: {{inventoryBaseUrl}}/proformas/{{proformaId}}/relations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "entityType": "lab_test",
    "entityId": "{{labTest5}}",
    "label": "Lab Test 5"
  }
}

assert {
  res.status: eq 201
}
