meta {
  name: 51 Verify Bandage stock at branch A (= 99)
  type: http
  seq: 19
}

get {
  url: {{inventoryBaseUrl}}/products/{{bandageId}}/stock
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Bandage branch A on-hand = 99 (100 - 1)", function () {
    const row = res.body.data.find(function (r) { return r.branchId === bru.getEnvVar("branchA"); });
    expect(row, "branch A stock row").to.not.be.undefined;
    expect(Number(row.quantity)).to.equal(99);
  });
}
