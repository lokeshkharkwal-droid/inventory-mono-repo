meta {
  name: Switch profile/branch (kalnostics)
  type: http
  seq: 2
}

post {
  url: {{kalnosticsBaseUrl}}/auth/switch-profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "profileKey": "{{profileKey}}",
    "branchId": "{{branchA}}"
  }
}

script:post-response {
  if ((res.status === 200 || res.status === 201) && res.body.data) {
    bru.setEnvVar("token", res.body.data.accessToken);
  }
}

docs {
  Manual helper to mint a token whose active branch is branchA. The numbered flow
  (00-switch-branchA) also does this, so you normally don't need to run this.
}
