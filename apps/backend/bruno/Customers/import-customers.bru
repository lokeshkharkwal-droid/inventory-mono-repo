meta {
  name: Import customers (preview)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/customers/import
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "dryRun": true,
    "rows": [
      { "name": "Walk-in Co", "phone": "9000000000", "email": "walkin@example.com" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.validated: eq 1
}
