meta {
  name: Import products (preview)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/products/import
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "dryRun": true,
    "rows": [
      { "code": "SKU-001", "name": "Sample product", "categoryId": "REPLACE_WITH_CATEGORY_ID", "price": 100, "cost": 60 }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.dryRun: eq true
}

docs {
  CSV import preview (dryRun). Each row is a CreateProductDto. Set a real
  categoryId, then re-run with dryRun=false to commit.
}
