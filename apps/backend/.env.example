# ─────────────────────────────────────────────────────────────────────────────
# inventory-backend environment template.
# Copy to `.env` and fill in. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3100

# ── Shared PostgreSQL database (THE kalnostics-new database) ──
# inventory-backend owns only the `inventory_*` tables in this database.
# Point this at the SAME Postgres instance kalnostics-new uses.
DATABASE_URL=postgresql://user:password@localhost:5432/kalnostics?schema=public

# ── Auth ──
# MUST be identical to kalnostics-new's JWT_SECRET so this service can validate
# the same business access tokens without an auth round-trip.
JWT_SECRET=change-me-to-match-kalnostics-new-at-least-32-chars

# ── Row-Level Security ──
# When true, PrismaService sets app.current_tenant_id per request so Postgres RLS
# (prisma/rls.sql) enforces tenant isolation. Requires rls.sql applied + a
# non-owner DB role. Default false → isolation relies on where-clauses.
RLS_ENABLED=false

# ── kalnostics-new integration API ──
# Base URL of the kalnostics-new backend (including its /api/v1 prefix). The
# integration clients forward the caller's Bearer token to these endpoints.
KALNOSTICS_API_BASE_URL=http://localhost:3000/api/v1
# Per-attempt HTTP timeout (ms) for integration calls.
KALNOSTICS_API_TIMEOUT_MS=15000

# ── CORS ──
# Comma-separated list of allowed frontend origins. Include the inventory-frontend
# (:5174), the SiteAdmin FE that manages master products (:3001), and the shared
# nginx front door (:8080) through which both are actually served.
# Falls back to permissive '*' in development when unset.
CORS_ORIGIN=http://localhost:5174,http://localhost:3001,http://localhost:8080

# ── Legacy MySQL source (data migration only; not used at runtime) ──
# Used by `pnpm migrate:inventory` to read the legacy ezhealthtrackv2_* databases.
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=ezpt
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=ezhealthtrackv2_business3
LEGACY_MYSQL_TABLE_PREFIX=ez_
